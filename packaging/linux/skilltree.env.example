SKILLTREE_HTTP_ADDR=127.0.0.1:8088
SKILLTREE_DATABASE_URL=postgres://skilltree:CHANGE_ME@127.0.0.1:5432/skilltree?sslmode=require
SKILLTREE_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SKILLTREE_COOKIE_SECURE=auto
SKILLTREE_TRUSTED_PROXIES=127.0.0.1,::1
SKILLTREE_ENV=production
SKILLTREE_SERVICE_NAME=skilltree
SKILLTREE_DISPLAY_NAME=Skilltree

# SMTP (für Firmen-Selbstregistrierung: Host + From Pflicht)
# SKILLTREE_SMTP_HOST=smtp.example.com
# SKILLTREE_SMTP_PORT=587
# SKILLTREE_SMTP_USER=skilltree@example.com
# SKILLTREE_SMTP_PASSWORD=CHANGE_ME
# SKILLTREE_SMTP_FROM=Skilltree <noreply@example.com>
# SKILLTREE_SMTP_TLS=starttls
