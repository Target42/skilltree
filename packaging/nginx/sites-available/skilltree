# Skilltree — skilltree.duckdns.org
# Requires: /etc/nginx/conf.d/skilltree-upstream.conf

server {
    listen 80;
    listen [::]:80;
    server_name skilltree.duckdns.org;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name skilltree.duckdns.org;

    ssl_certificate     /etc/letsencrypt/live/skilltree.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/skilltree.duckdns.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include snippets/skilltree-security-headers.conf;

    server_tokens off;
    client_max_body_size 1m;

    limit_conn skilltree_conn 20;

    location = /healthz {
        proxy_pass http://skilltree_app;
        include snippets/skilltree-proxy-params.conf;
        access_log off;
    }

    location = /login {
        limit_req zone=skilltree_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://skilltree_app;
        include snippets/skilltree-proxy-params.conf;
    }

    location / {
        proxy_pass http://skilltree_app;
        include snippets/skilltree-proxy-params.conf;
    }
}
