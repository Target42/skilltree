SKILLTREE_HTTP_ADDR=127.0.0.1:8088
SKILLTREE_DATABASE_URL=postgres://skilltree:skilltree@127.0.0.1:55432/skilltree?sslmode=disable
SKILLTREE_SESSION_SECRET=dev-only-change-me-skilltree-session
# auto | true | false — Secure-Flag am Cookie (auto: TLS oder X-Forwarded-Proto von Trusted Proxy)
SKILLTREE_COOKIE_SECURE=auto
# Nur diese Peers dürfen X-Forwarded-* setzen (nginx auf demselben Host)
SKILLTREE_TRUSTED_PROXIES=127.0.0.1,::1
# production erzwingt starkes Session-Secret (≥32 Zeichen, kein Dev-Default)
# SKILLTREE_ENV=production

# SMTP (für Firmen-Selbstregistrierung Pflicht: Host + From; ohne beides kein Mail-Versand)
# SKILLTREE_SMTP_HOST=smtp.example.com
# SKILLTREE_SMTP_PORT=587
# SKILLTREE_SMTP_USER=skilltree@example.com
# SKILLTREE_SMTP_PASSWORD=secret
# SKILLTREE_SMTP_FROM=Skilltree <skilltree@example.com>
# SKILLTREE_SMTP_TLS=starttls
